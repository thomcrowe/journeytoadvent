# Copy to .env.local for local development. Set the same values in Vercel.

# Public site URL (used in emails, RSS, sitemap, canonical links)
NEXT_PUBLIC_SITE_URL=https://journeytoadvent.com

# Sanity. Without a project ID the site runs on built-in sample content.
NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_READ_TOKEN=          # Viewer token: drafts for preview / Presentation tool
SANITY_API_WRITE_TOKEN=         # Editor token: seed script and the daily email log
SANITY_REVALIDATE_SECRET=       # Shared secret for the Sanity webhook → /api/revalidate

# Email (Resend). Resend replaced Audiences with Segments; RESEND_AUDIENCE_ID still works.
RESEND_API_KEY=
RESEND_SEGMENT_ID=
RESEND_AUDIENCE_ID=
EMAIL_FROM="Journey to Advent <hello@journeytoadvent.com>"
EMAIL_TEST_TO=                  # Where ?dryRun=1 sends the daily email
SUBSCRIBE_SECRET=               # Signs confirmation links (any long random string)

# Vercel Cron sends this as a Bearer token
CRON_SECRET=

# PostHog
NEXT_PUBLIC_POSTHOG_KEY=
NEXT_PUBLIC_POSTHOG_HOST=https://us.i.posthog.com

# Time travel for testing (YYYY-MM-DD). Ignored when VERCEL_ENV=production.
RELEASE_DATE_OVERRIDE=
